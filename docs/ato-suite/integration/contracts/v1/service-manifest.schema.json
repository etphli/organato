{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ato.local/contracts/v1/service-manifest.schema.json",
  "title": "Ato service manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "app",
    "displayName",
    "contractVersions",
    "resourceTypes",
    "capabilities",
    "links"
  ],
  "properties": {
    "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "contractVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\d+\\.\\d+$" }
    },
    "resourceTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "eventPull": { "type": "boolean" },
        "snapshotPull": { "type": "boolean" },
        "commands": { "type": "boolean" },
        "webhookNudge": { "type": "boolean" }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "events", "snapshot"],
      "properties": {
        "health": { "type": "string" },
        "events": { "type": "string" },
        "snapshot": { "type": "string" },
        "commands": { "type": "string" }
      }
    }
  }
}
