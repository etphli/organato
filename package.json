{
  "name": "organato",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @organato/web --filter @organato/worker dev",
    "dev:web": "pnpm --filter @organato/web dev",
    "dev:worker": "pnpm --filter @organato/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:connector && pnpm build && pnpm licenses:check && pnpm audit:prod && pnpm secrets:scan",
    "licenses:check": "node scripts/check-licenses.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "scheduler:benchmark": "node scripts/benchmark-scheduler.mjs",
    "scheduler:install": "node scripts/install-launchd.mjs",
    "verify:production-email": "node scripts/verify-production-email.mjs",
    "test:connector": "node scripts/test-canvas-connector.mjs",
    "package:connector": "node scripts/package-canvas-connector.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
