# Public web configuration
VITE_API_BASE_URL=http://localhost:8787
VITE_DEMO_MODE=false
DEMO_MODE=false

# Exact deployment values (never commit real secrets)
APP_ORIGIN=http://localhost:5173
ALLOWED_GOOGLE_EMAILS=owner@example.com
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-worker-secret
SESSION_SECRET=replace-with-32-byte-worker-secret
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-worker-secret

# Provider setup values
CANVAS_BASE_URL=https://canvas.example.edu
GOOGLE_INTEGRATION_OWNER_EMAIL=owner@example.com
DIGEST_RECIPIENTS=owner@example.com

# Local scheduler fallback
ORGANATO_API_URL=http://localhost:8787
ORGANATO_SCHEDULER_TOKEN=replace-with-worker-secret
SCHEDULER_MODE=local
