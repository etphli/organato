{
  "name": "Organato",
  "short_name": "Organato",
  "description": "A private school workload command centre.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "url": "/",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Todo",
      "url": "/todo",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
    },
    {
      "name": "New todo",
      "url": "/todo?new=1",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
    }
  ]
}
