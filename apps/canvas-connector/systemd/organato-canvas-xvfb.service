[Unit]
Description=Organato Canvas connector virtual display
After=local-fs.target

[Service]
Type=simple
User=organato-canvas
Group=organato-canvas
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x900x24 -nolisten tcp -auth /var/lib/organato-canvas-connector/Xauthority
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/tmp
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
