{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "organato",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "organato-production",
      "database_id": "a653bf6d-e7d4-4429-af3a-fc30bd839af4",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CANVAS_CONNECTOR", "class_name": "CanvasConnector" },
    ],
  },
  // R2 file attachments: uncomment after enabling R2 in the Cloudflare
  // dashboard and creating the bucket with
  // `wrangler r2 bucket create organato-attachments`. Code serves 501
  // without it; links are unaffected.
  // "r2_buckets": [
  //   {
  //     "binding": "ATTACHMENTS",
  //     "bucket_name": "organato-attachments",
  //   },
  // ],
  "migrations": [
    { "tag": "canvas-connector-v1", "new_sqlite_classes": ["CanvasConnector"] },
  ],
  "vars": {
    "CONNECTOR_PUBLIC_ORIGIN": "https://organato.etphli.workers.dev",
    "APP_ORIGIN": "https://organato.vercel.app",
    "ALLOWED_GOOGLE_EMAILS": "ethan.likht@gmail.com,likht.ethan@emanuelschool.nsw.edu.au",
    "GOOGLE_CLIENT_ID": "190702448599-eg9o5ehknkbo29d2nifqg3l0tr3fpk67.apps.googleusercontent.com",
    "CANVAS_BASE_URL": "https://emanuel.instructure.com",
    "CANVAS_DISPLAY_NAME": "Emanuel School Canvas",
    "DEMO_MODE": "false",
    "SCHEDULER_MODE": "local",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
